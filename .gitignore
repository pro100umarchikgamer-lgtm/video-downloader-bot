# Секреты
.env

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
htmlcov/
.coverage

# Runtime-данные: SQLite база и временные каталоги загрузок
# (были описаны как "не должны попадать в Git" в истории проекта, но
# раньше .gitignore закрывал только data/tmp/, а не весь data/)
data/

# Скачанные/собранные видео и логи, которые не должны коммититься
*.mp4
*.log

# Диагностические/тестовые артефакты, упомянутые как временные
# рабочие файлы (не должны автоматически попадать в production commit)
get_channel_ids.py
test_cache_channels.py
youtube_test*.txt
youtube_debug.txt

# Cookies/сессии (код сейчас их не создаёт, но yt-dlp на VPS иногда
# настраивают с cookies.txt для авторизации в YouTube — не должны
# попасть в репозиторий, если появятся)
cookies.txt
*.cookies
*.session
*.db-backup-*
