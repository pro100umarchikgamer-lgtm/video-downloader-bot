# Required secret from @BotFather
BOT_TOKEN=

# Bootstrap owners, comma-separated Telegram user IDs. These owners cannot be
# removed in /admin. At least one is strongly recommended.
ADMIN_IDS=

# Optional fallback: administrators of this Telegram chat receive role admin.
ADMIN_GROUP_ID=

# Persistent paths inside the container. Existing ./data/bot.db is migrated in
# place; do not point TEMP_DIR outside the mounted data directory in Docker.
DATA_DIR=./data
DATABASE_PATH=./data/bot.db
TEMP_DIR=./data/tmp

LOG_LEVEL=INFO
APP_VERSION=2.0.0

# Optional Local Bot API. Leave blank for the Telegram cloud Bot API (49 MB
# safe application limit). For local mode, also set TELEGRAM_API_ID/HASH and
# start the Compose profile documented in README; safe limit defaults to
# 1900 MB. API_ID/HASH are secrets obtained from my.telegram.org.
TELEGRAM_API_BASE_URL=
TELEGRAM_API_IS_LOCAL=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Legacy cache channels are imported into SQLite on first startup. They remain
# supported so the production .env can be reused; future changes are made in
# /admin -> Storage. Empty values are allowed: downloads still work directly.
CACHE_SMALL=
CACHE_MEDIUM=
CACHE_LARGE=
CACHE_ADULT=

# Initial runtime defaults. After the first startup these values live in
# SQLite and are managed in /admin -> Settings; changing an env value does not
# overwrite an existing runtime setting.
DEFAULT_QUALITY=auto
GROUP_DEFAULT_QUALITY=auto
MAX_CONCURRENT_DOWNLOADS=2
QUEUE_WORKERS=2
MAX_BATCH_SIZE=6
MAX_USER_QUEUE=6
MIN_MESSAGE_INTERVAL=9
SMALL_TIER_MAX_MB=500
MEDIUM_TIER_MAX_MB=1024
# Blank means 49 in cloud mode or 1900 in Local Bot API mode.
MAX_DELIVERY_MB=
VIDEO_NOTE_ENABLED=true
QUALITY_SELECTION_ENABLED=true
MAINTENANCE_MODE=false
TEMP_RETENTION_MINUTES=60
VIDEO_NOTE_SOURCE_TTL_MINUTES=30
EVENT_RETENTION_DAYS=90
DOWNLOAD_HISTORY_RETENTION_DAYS=365
DISK_MIN_FREE_MB=1024
OPERATIONAL_ALERTS=true

# MAX_FILESIZE_MB from v0 is intentionally obsolete. It may remain in an old
# production .env but is ignored; transport mode now determines the real cap.
